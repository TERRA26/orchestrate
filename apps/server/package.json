{
  "name": "orchestrate",
  "version": "0.0.15",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pingdotgg/orchestrate",
    "directory": "apps/server"
  },
  "bin": {
    "orchestrate": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun --watch run src/index.ts",
    "build": "bun scripts/cli.ts build",
    "start": "node dist/index.mjs",
    "prepare": "effect-language-service patch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:orchestrator-smoke": "vitest run src/reviewer/ReviewerLoop.integration.test.ts",
    "test:orchestrator-journey": "vitest run src/wsServer.orchestrator.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.77",
    "@effect/platform-node": "catalog:",
    "@effect/sql-sqlite-bun": "catalog:",
    "@pierre/diffs": "^1.1.0-beta.16",
    "effect": "catalog:",
    "node-pty": "^1.1.0",
    "open": "^11.0.0",
    "playwright": "^1.58.2",
    "tree-kill": "^1.2.2",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@effect/vitest": "catalog:",
    "@orchestrate/contracts": "workspace:*",
    "@orchestrate/shared": "workspace:*",
    "@orchestrate/web": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/ws": "^8.5.13",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^22.16 || ^23.11 || >=24.10"
  }
}

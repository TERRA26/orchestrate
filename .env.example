# Orchestrate local environment template
#
# Copy this file to `.env.local` and fill in values for your machine.
# `.env.local` and other `.env.*` files are gitignored.

# Optional web/server overrides
PORT=5733
ORCHESTRATE_PORT=3773
ORCHESTRATE_HOST=127.0.0.1
ORCHESTRATE_HOME=
ORCHESTRATE_AUTH_TOKEN=

# Provider credentials
# Codex and Claude can also use their native CLIs/auth stores.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Voice mode and LiveKit
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_VOICE_AGENT_NAME=orchestrate-voice-agent
ORCHESTRATE_VOICE_AGENT_SECRET=
ORCHESTRATE_HTTP_URL=http://localhost:3773

# Voice tuning
ORCHESTRATE_VOICE_OPENAI_REALTIME_MODEL=gpt-realtime-mini
ORCHESTRATE_VOICE_OPENAI_VOICE=alloy
ORCHESTRATE_VOICE_MAX_RESPONSE_OUTPUT_TOKENS=1536
ORCHESTRATE_VOICE_MAX_SESSION_DURATION_MS=600000
ORCHESTRATE_VOICE_TURN_EAGERNESS=high
ORCHESTRATE_VOICE_MAX_TOOL_STEPS=24
ORCHESTRATE_VOICE_IDLE_JOB_PROCESSES=1
ORCHESTRATE_VOICE_INITIALIZE_PROCESS_TIMEOUT_MS=30000
